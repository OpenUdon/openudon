{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openudon.dev/schemas/openudon.browser-authoring-handoff.v1.schema.json",
  "title": "OpenUdon Browser Authoring Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "example",
    "target",
    "private_root",
    "authority",
    "stages",
    "accepted_outputs",
    "rejected_inputs",
    "diagnostics",
    "retention_class",
    "safe_to_archive",
    "redaction_required_before_share"
  ],
  "properties": {
    "version": { "const": "openudon.browser-authoring-handoff.v1" },
    "status": { "enum": ["ready", "needs_reviewed_profiles"] },
    "example": { "$ref": "#/$defs/absolutePath" },
    "target": { "$ref": "#/$defs/target" },
    "private_root": { "$ref": "#/$defs/absolutePath" },
    "authority": { "$ref": "#/$defs/authority" },
    "stages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/stage" }
    },
    "accepted_outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/acceptedOutput" }
    },
    "rejected_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "resume": { "$ref": "#/$defs/resume" },
    "diagnostics": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "retention_class": { "const": "local_ephemeral" },
    "safe_to_archive": { "const": false },
    "redaction_required_before_share": { "const": true }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
      "then": {
        "required": ["resume"],
        "properties": {
          "target": { "properties": { "login_state_required": { "const": false } } },
          "authority": {
            "properties": {
              "external_capture_allowed_network_methods": { "const": ["GET", "HEAD"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "needs_reviewed_profiles" } }, "required": ["status"] },
      "then": {
        "not": { "required": ["resume"] },
        "properties": {
          "target": { "properties": { "login_state_required": { "const": true } } },
          "authority": {
            "properties": {
              "external_capture_allowed_network_methods": { "maxItems": 0 }
            }
          },
          "stages": {
            "items": {
              "not": { "required": ["argv"] }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "stringArray": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "approved_origins", "profile_id", "action_hint", "login_state_required"],
      "properties": {
        "url": { "type": "string", "format": "uri", "maxLength": 4096 },
        "approved_origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "maxLength": 1024 }
        },
        "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "action_hint": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
        "login_state_required": { "type": "boolean" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "icot_launches_browser",
        "icot_runs_browsertools",
        "icot_reads_credential_environment",
        "handoff_carries_credential_values",
        "handoff_carries_session_state",
        "external_run_may_launch_browser",
        "external_capture_allowed_network_methods",
        "requires_external_operator_run"
      ],
      "properties": {
        "icot_launches_browser": { "const": false },
        "icot_runs_browsertools": { "const": false },
        "icot_reads_credential_environment": { "const": false },
        "handoff_carries_credential_values": { "const": false },
        "handoff_carries_session_state": { "const": false },
        "external_run_may_launch_browser": { "const": true },
        "external_capture_allowed_network_methods": {
          "type": "array",
          "maxItems": 2,
          "items": { "enum": ["GET", "HEAD"] }
        },
        "requires_external_operator_run": { "const": true }
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "expansion", "source", "constraint"],
      "properties": {
        "token": { "type": "string", "pattern": "^<[^<>]+>$", "maxLength": 128 },
        "expansion": { "enum": ["scalar", "argv_fragment"] },
        "source": { "$ref": "#/$defs/nonemptyString" },
        "constraint": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,127}$" },
        "kind": { "enum": ["external_command", "manual_review", "operator_handoff"] },
        "argv": { "$ref": "#/$defs/stringArray" },
        "produces": { "$ref": "#/$defs/nonemptyString" },
        "requires": { "$ref": "#/$defs/stringArray" },
        "operator_gate": { "$ref": "#/$defs/nonemptyString" },
        "placeholders": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/placeholder" }
        }
      }
    },
    "acceptedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "use"],
      "properties": {
        "version": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 128 },
        "use": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": { "$ref": "#/$defs/stringArray" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 128 },
        "message": { "$ref": "#/$defs/nonemptyString" }
      }
    }
  }
}
