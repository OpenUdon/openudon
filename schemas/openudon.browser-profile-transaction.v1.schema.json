{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openudon.dev/schemas/openudon.browser-profile-transaction.v1.schema.json",
  "title": "OpenUdon Browser Profile Transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "kind",
    "state",
    "candidates",
    "provenance",
    "credential_bindings"
  ],
  "properties": {
    "version": { "const": "openudon.browser-profile-transaction.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "kind": { "enum": ["authentication_capability", "registration"] },
    "state": { "enum": ["candidate", "reviewed", "prepared", "promoted", "cancelled", "failed", "indeterminate"] },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "credential_bindings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/credentialBinding" }
    },
    "session": { "$ref": "#/$defs/symbol" },
    "preparation": { "$ref": "#/$defs/preparation" },
    "promotion": { "$ref": "#/$defs/promotion" },
    "failure": { "$ref": "#/$defs/failure" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "authentication_capability" } }, "required": ["kind"] },
      "then": {
        "required": ["session"],
        "properties": {
          "candidates": {
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              { "$ref": "#/$defs/authenticationCandidate" },
              { "$ref": "#/$defs/capabilityCandidate" }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "registration" } }, "required": ["kind"] },
      "then": {
        "not": { "required": ["session"] },
        "properties": {
          "candidates": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [{ "$ref": "#/$defs/registrationCandidate" }],
            "items": false
          },
          "credential_bindings": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "state": { "enum": ["candidate", "reviewed"] } }, "required": ["state"] },
      "then": { "not": { "anyOf": [{ "required": ["preparation"] }, { "required": ["promotion"] }, { "required": ["failure"] }] } }
    },
    {
      "if": { "properties": { "state": { "const": "prepared" } }, "required": ["state"] },
      "then": { "required": ["preparation"], "not": { "anyOf": [{ "required": ["promotion"] }, { "required": ["failure"] }] } }
    },
    {
      "if": { "properties": { "state": { "const": "promoted" } }, "required": ["state"] },
      "then": { "required": ["preparation", "promotion"], "not": { "required": ["failure"] } }
    },
    {
      "if": { "properties": { "state": { "enum": ["failed", "indeterminate"] } }, "required": ["state"] },
      "then": { "required": ["failure"], "not": { "required": ["promotion"] } }
    },
    {
      "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
      "then": {
        "properties": {
          "failure": {
            "properties": { "class": { "enum": ["rejected", "conflict", "operational"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "indeterminate" } }, "required": ["state"] },
      "then": {
        "required": ["preparation"],
        "properties": {
          "failure": {
            "properties": {
              "class": { "const": "indeterminate" },
              "code": { "const": "promotion_indeterminate" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "cancelled" } }, "required": ["state"] },
      "then": { "not": { "anyOf": [{ "required": ["promotion"] }, { "required": ["failure"] }] } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "symbol": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema", "source_sha256", "review_sha256"],
      "properties": {
        "kind": { "enum": ["authentication", "capability", "registration"] },
        "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
        "source_sha256": { "$ref": "#/$defs/digest" },
        "review_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "authenticationCandidate": {
      "allOf": [
        { "$ref": "#/$defs/candidate" },
        {
          "properties": {
            "kind": { "const": "authentication" },
            "schema": { "enum": ["uws.browser-authentication.1.0", "uws.browser-authentication.1.1"] }
          }
        }
      ]
    },
    "capabilityCandidate": {
      "allOf": [
        { "$ref": "#/$defs/candidate" },
        {
          "properties": {
            "kind": { "const": "capability" },
            "schema": { "enum": ["uws.browser.1.5", "uws.browser.1.6", "uws.browser.1.7"] }
          }
        }
      ]
    },
    "registrationCandidate": {
      "allOf": [
        { "$ref": "#/$defs/candidate" },
        {
          "properties": {
            "kind": { "const": "registration" },
            "schema": { "const": "uws.browser-registration.1.0" }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "result_version", "result_sha256", "observed_at", "expires_at", "origins"],
      "properties": {
        "producer": { "const": "browsertools" },
        "result_version": {
          "enum": ["browsertools.authenticated-authoring.v2", "browsertools.registration-authoring.v1"]
        },
        "result_sha256": { "$ref": "#/$defs/digest" },
        "observed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "maxLength": 1024 }
        }
      }
    },
    "credentialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "binding"],
      "properties": {
        "slot": { "$ref": "#/$defs/symbol" },
        "binding": { "$ref": "#/$defs/symbol" }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_sha256", "qualification_sha256"],
      "properties": {
        "package_sha256": { "$ref": "#/$defs/digest" },
        "qualification_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_sha256"],
      "properties": { "generation_sha256": { "$ref": "#/$defs/digest" } }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "code"],
      "properties": {
        "class": { "enum": ["rejected", "conflict", "operational", "indeterminate"] },
        "code": {
          "enum": [
            "transaction_invalid",
            "candidate_invalid",
            "candidate_stale",
            "digest_mismatch",
            "review_rejected",
            "workspace_conflict",
            "preparation_failed",
            "qualification_failed",
            "promotion_failed",
            "promotion_indeterminate"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "class": { "const": "rejected" } }, "required": ["class"] },
          "then": { "properties": { "code": { "enum": ["transaction_invalid", "candidate_invalid", "candidate_stale", "digest_mismatch", "review_rejected"] } } }
        },
        {
          "if": { "properties": { "class": { "const": "conflict" } }, "required": ["class"] },
          "then": { "properties": { "code": { "const": "workspace_conflict" } } }
        },
        {
          "if": { "properties": { "class": { "const": "operational" } }, "required": ["class"] },
          "then": { "properties": { "code": { "enum": ["preparation_failed", "qualification_failed", "promotion_failed"] } } }
        },
        {
          "if": { "properties": { "class": { "const": "indeterminate" } }, "required": ["class"] },
          "then": { "properties": { "code": { "const": "promotion_indeterminate" } } }
        }
      ]
    }
  }
}
