{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openudon.dev/schemas/openudon.browser-registration-attestation.v3.schema.json",
  "title": "OpenUdon Two-Prior-Attempt Pre-Submission Recovery Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "package_sha256",
    "profile_sha256",
    "operation",
    "flow",
    "prior_attempts",
    "dedicated_test",
    "cleanup_disposition",
    "reviewer",
    "expires_at",
    "recovery"
  ],
  "properties": {
    "version": {
      "const": "openudon.browser-registration-attestation.v3"
    },
    "package_sha256": {
      "$ref": "#/$defs/digest"
    },
    "profile_sha256": {
      "$ref": "#/$defs/digest"
    },
    "operation": {
      "$ref": "#/$defs/symbol"
    },
    "flow": {
      "$ref": "#/$defs/symbol"
    },
    "prior_attempts": {
      "const": 2
    },
    "dedicated_test": {
      "const": true
    },
    "cleanup_disposition": {
      "const": "delete_separately"
    },
    "reviewer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,127}$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_sha256",
        "claim_sha256",
        "prior_attestation_sha256",
        "prior_run_evidence_sha256",
        "prior_executor_report_sha256",
        "outcome"
      ],
      "properties": {
        "authority_sha256": {
          "$ref": "#/$defs/digest"
        },
        "claim_sha256": {
          "$ref": "#/$defs/digest"
        },
        "prior_attestation_sha256": {
          "$ref": "#/$defs/digest"
        },
        "prior_run_evidence_sha256": {
          "$ref": "#/$defs/digest"
        },
        "prior_executor_report_sha256": {
          "$ref": "#/$defs/digest"
        },
        "outcome": {
          "const": "submission_not_started"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    }
  }
}
