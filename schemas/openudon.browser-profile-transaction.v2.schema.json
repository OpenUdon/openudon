{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openudon.dev/schemas/openudon.browser-profile-transaction.v2.schema.json",
  "title": "OpenUdon Browser Registration Profile Transaction v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "kind", "state", "candidates", "provenance", "credential_bindings"],
  "properties": {
    "version": { "const": "openudon.browser-profile-transaction.v2" },
    "id": { "$ref": "#/$defs/symbol" },
    "kind": { "const": "registration" },
    "state": { "enum": ["candidate", "reviewed", "prepared", "promoted", "cancelled", "failed", "indeterminate"] },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{ "$ref": "#/$defs/registrationCandidate" }],
      "items": false
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "credential_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/credentialBinding" }
    },
    "preparation": { "$ref": "#/$defs/preparation" },
    "promotion": { "$ref": "#/$defs/promotion" },
    "failure": { "$ref": "#/$defs/failure" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["candidate", "reviewed"] } }, "required": ["state"] },
      "then": { "not": { "anyOf": [{ "required": ["preparation"] }, { "required": ["promotion"] }, { "required": ["failure"] }] } }
    },
    {
      "if": { "properties": { "state": { "const": "prepared" } }, "required": ["state"] },
      "then": { "required": ["preparation"], "not": { "anyOf": [{ "required": ["promotion"] }, { "required": ["failure"] }] } }
    },
    {
      "if": { "properties": { "state": { "const": "promoted" } }, "required": ["state"] },
      "then": { "required": ["preparation", "promotion"], "not": { "required": ["failure"] } }
    },
    {
      "if": { "properties": { "state": { "enum": ["failed", "indeterminate"] } }, "required": ["state"] },
      "then": { "required": ["failure"], "not": { "required": ["promotion"] } }
    },
    {
      "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
      "then": { "properties": { "failure": { "properties": { "class": { "enum": ["rejected", "conflict", "operational"] } } } } }
    },
    {
      "if": { "properties": { "state": { "const": "indeterminate" } }, "required": ["state"] },
      "then": {
        "required": ["preparation"],
        "properties": { "failure": { "properties": { "class": { "const": "indeterminate" }, "code": { "const": "promotion_indeterminate" } } } }
      }
    },
    {
      "if": { "properties": { "state": { "const": "cancelled" } }, "required": ["state"] },
      "then": { "not": { "anyOf": [{ "required": ["promotion"] }, { "required": ["failure"] }] } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "symbol": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "bindingSymbol": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
    "registrationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema", "source_sha256", "review_sha256"],
      "properties": {
        "kind": { "const": "registration" },
        "schema": { "const": "uws.browser-registration.1.0" },
        "source_sha256": { "$ref": "#/$defs/digest" },
        "review_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "result_version", "result_sha256", "observed_at", "expires_at", "origins"],
      "properties": {
        "producer": { "const": "browsertools" },
        "result_version": { "const": "browsertools.registration-authoring.v2" },
        "result_sha256": { "$ref": "#/$defs/digest" },
        "observed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "maxLength": 1024 }
        }
      }
    },
    "credentialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "binding"],
      "properties": {
        "slot": { "$ref": "#/$defs/bindingSymbol" },
        "binding": { "$ref": "#/$defs/bindingSymbol" }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_sha256", "qualification_sha256"],
      "properties": {
        "package_sha256": { "$ref": "#/$defs/digest" },
        "qualification_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_sha256"],
      "properties": { "generation_sha256": { "$ref": "#/$defs/digest" } }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "code"],
      "properties": {
        "class": { "enum": ["rejected", "conflict", "operational", "indeterminate"] },
        "code": {
          "enum": ["transaction_invalid", "candidate_invalid", "candidate_stale", "digest_mismatch", "review_rejected", "workspace_conflict", "preparation_failed", "qualification_failed", "promotion_failed", "promotion_indeterminate"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "class": { "const": "rejected" } }, "required": ["class"] },
          "then": { "properties": { "code": { "enum": ["transaction_invalid", "candidate_invalid", "candidate_stale", "digest_mismatch", "review_rejected"] } } }
        },
        {
          "if": { "properties": { "class": { "const": "conflict" } }, "required": ["class"] },
          "then": { "properties": { "code": { "const": "workspace_conflict" } } }
        },
        {
          "if": { "properties": { "class": { "const": "operational" } }, "required": ["class"] },
          "then": { "properties": { "code": { "enum": ["preparation_failed", "qualification_failed", "promotion_failed"] } } }
        },
        {
          "if": { "properties": { "class": { "const": "indeterminate" } }, "required": ["class"] },
          "then": { "properties": { "code": { "const": "promotion_indeterminate" } } }
        }
      ]
    }
  }
}
