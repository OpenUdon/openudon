{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "openudon.execution-plan.v1"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "handoff_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "closure_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "binary_sha256",
        "closure_sha256",
        "runtime_revision"
      ]
    },
    "assessment_outcome": {
      "enum": [
        "compatible",
        "indeterminate"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "invocation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "kind": {
            "enum": [
              "http",
              "fnct"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$"
              },
              "kind": {
                "enum": [
                  "openapi",
                  "google-discovery",
                  "aws-smithy",
                  "asyncapi",
                  "graphql",
                  "openrpc",
                  "grpc-protobuf",
                  "odata",
                  "runtime-function"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "url": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "kind",
              "sha256"
            ]
          },
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "id",
                  "ref"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "kind",
              "value",
              "key"
            ]
          },
          "method": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "maxLength": 2048
          },
          "path_template": {
            "type": "string",
            "maxLength": 4096
          },
          "constraints_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "metadata_complete": {
            "type": "boolean"
          },
          "security": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "known": {
                "type": "boolean"
              },
              "alternatives": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "requirements": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "scheme": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "type": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "location": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "name": {
                            "type": "string",
                            "maxLength": 1024
                          },
                          "scopes": {
                            "type": "array",
                            "maxItems": 128,
                            "items": {
                              "type": "string",
                              "maxLength": 1024
                            }
                          }
                        },
                        "required": [
                          "scheme",
                          "type"
                        ]
                      }
                    }
                  },
                  "required": [
                    "requirements"
                  ]
                }
              }
            },
            "required": [
              "known"
            ]
          }
        },
        "required": [
          "step_id",
          "operation_id",
          "invocation_id",
          "kind",
          "source",
          "selector",
          "method",
          "origin",
          "path_template",
          "constraints_sha256",
          "metadata_complete",
          "security"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "http"
                }
              }
            },
            "then": {
              "properties": {
                "method": {
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE",
                    "OPTIONS"
                  ]
                },
                "origin": {
                  "minLength": 1
                },
                "path_template": {
                  "minLength": 1
                },
                "metadata_complete": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "method": {
                  "const": ""
                },
                "origin": {
                  "const": ""
                },
                "path_template": {
                  "const": ""
                },
                "source": {
                  "properties": {
                    "kind": {
                      "const": "runtime-function"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "version",
    "scope",
    "package_sha256",
    "handoff_sha256",
    "inputs_sha256",
    "worker",
    "assessment_outcome",
    "operations",
    "plan_sha256"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openudon.org/schemas/openudon.execution-plan.v1.schema.json",
  "description": "Exact review metadata only. Canonical digest, selected worker, source reproduction, runtime admission and current host approval are independently verified by packagev3 APIs."
}
